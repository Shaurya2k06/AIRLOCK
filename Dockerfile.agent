FROM node:22-bookworm-slim

WORKDIR /app

COPY contracts/package.json contracts/package-lock.json ./contracts/
RUN npm --prefix contracts ci --ignore-scripts

COPY server/package.json server/package-lock.json ./server/
RUN npm --prefix server ci --ignore-scripts

COPY contracts/scripts/manifest.mjs ./contracts/scripts/manifest.mjs
COPY server ./server
COPY fixtures ./fixtures
COPY airlock-manifest.json ./airlock-manifest.json
COPY server/deployments.json ./deployments.json

ENV HOST=0.0.0.0
ENV PORT=8787
EXPOSE 8787

CMD ["node", "server/index.js"]
