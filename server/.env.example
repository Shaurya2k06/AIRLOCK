# Required for all reads and writes.
CREDITCOIN_RPC_URL=

# Optional paths and listener settings.
AIRLOCK_DEPLOYMENTS=../deployments.json
AIRLOCK_MANIFEST_FILE=../airlock-manifest.json
HOST=127.0.0.1
PORT=8787

# Write runbook actions are disabled unless explicitly enabled on a loopback server.
AIRLOCK_ENABLE_WRITES=false
AIRLOCK_CLIENT_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
AIRLOCK_COMMAND_TIMEOUT_MS=900000
AIRLOCK_PUBLIC_URL=http://127.0.0.1:8787
AIRLOCK_MCP_AUDIENCE=http://127.0.0.1:8787/mcp
AIRLOCK_CREDENTIAL_ISSUER_PRIVATE_KEY=
AIRLOCK_CREDENTIAL_ISSUER_ADDRESS=
AIRLOCK_CREDENTIAL_TTL_SECONDS=300
AIRLOCK_MAX_DELEGATION_DEPTH=3
AIRLOCK_DELEGATION_RISK_LIMIT=1
AIRLOCK_AGENT_REGISTRY=
AIRLOCK_AGENT_ID=
AIRLOCK_IDENTITY_RPC_URL=
AIRLOCK_IPFS_GATEWAY=
AIRLOCK_AUTHORIZATION_SERVER=
AIRLOCK_APPROVED_EVALUATORS=
AIRLOCK_MIN_EVALUATOR_QUORUM=2
AIRLOCK_X402_PRICE=
AIRLOCK_X402_SETTLE_URL=
SPIFFE_ENDPOINT_SOCKET=
SPIFFE_ID=
