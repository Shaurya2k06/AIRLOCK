# Required for chain-backed reads; leave empty for explicit local fixture mode.
CREDITCOIN_RPC_URL=

# Optional paths and listener settings.
AIRLOCK_DEPLOYMENTS=../deployments.json
HOST=127.0.0.1
PORT=8787

# Write runbook actions are disabled unless explicitly enabled on a loopback server.
AIRLOCK_ENABLE_WRITES=false
AIRLOCK_CLIENT_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
AIRLOCK_COMMAND_TIMEOUT_MS=900000
