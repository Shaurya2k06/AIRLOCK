{
  "name": "contracts",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "hardhat build",
    "test": "hardhat test",
    "typecheck": "tsc --noEmit",
    "manifest": "node scripts/manifest.mjs",
    "manifest:test": "node --test scripts/manifest.test.mjs",
    "abi:check": "node scripts/abi-check.mjs",
    "security:check": "node scripts/secret-check.mjs",
    "live:check": "hardhat run scripts/live-check.ts",
    "deploy-live": "hardhat run scripts/deploy-live.ts",
    "import-proof": "hardhat run scripts/import-proof.ts",
    "import-proof:batch": "hardhat run scripts/import-batch-proof.ts",
    "register-tee-binding": "hardhat run scripts/register-tee-binding.ts",
    "worker": "hardhat run scripts/worker.ts",
    "live-step": "hardhat run scripts/live-step.ts",
    "ci": "npm run build && npm run typecheck && npm run manifest:test && npm run abi:check && npm run security:check && npm test"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.0.15",
    "@nomicfoundation/hardhat-ignition": "^3.1.8",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^3.0.7",
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.2",
    "chai": "^6.2.2",
    "ethers": "^6.17.0",
    "forge-std": "github:foundry-rs/forge-std#v1.16.2",
    "hardhat": "^3.16.0",
    "mocha": "^11.8.0",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "@gluwa/asc-contracts": "^0.2.1",
    "@gluwa/usc-sdk": "^0.18.0",
    "cbor2": "^2.3.0",
    "dotenv": "^17.4.2"
  }
}
